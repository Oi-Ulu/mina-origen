---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Minería de origen sostenible en Guainía y Marmato" } = Astro.props;
let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Mina Origen</title>
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  </head>
  <body class="bg-stone-950 text-gray-200 font-sans antialiased">
    <header class="border-b border-stone-700 py-4 px-4 md:px-8">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href={baseUrl} class="font-serif text-2xl tracking-wide text-guainia-reflection-warm">
          Mina<span class="text-marmato-silver-vein">Origen</span>
        </a>
        <nav class="space-x-6 text-sm">
          <a href={`${baseUrl}territorio/guainia/`} class="hover:text-guainia-reflection-warm transition">Guainía</a>
          <a href={`${baseUrl}territorio/marmato/`} class="hover:text-marmato-silver-vein transition">Marmato</a>
          <a href={`${baseUrl}contacto`} class="hover:text-white transition">Contacto</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-stone-800 mt-20 py-8 px-4 text-center text-gray-400 text-sm">
      <div class="max-w-7xl mx-auto">
        <p>© 2026 Mina Origen. Operaciones sostenibles en Guainía y Marmato, Colombia.</p>
        <p class="mt-2 text-xs">Comprometidos con la minería artesanal responsable y la restauración ambiental.</p>
      </div>
    </footer>
  </body>
</html>