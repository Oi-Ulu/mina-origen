---
import { processCardTheme } from '../../lib/themes.js';

export interface ImagenInfo {
  src: string;
  tipo: 'real' | 'render';
  alt: string;
}

export interface Props {
  etapa: string;
  descripcion: string;
  imagenes?: ImagenInfo[];
  tema: 'marmato' | 'guainia';
}
const { etapa, descripcion, imagenes, tema } = Astro.props;
const theme = processCardTheme[tema];
const borderClass = tema === 'marmato'
  ? 'border-l-2 border-marmato-clay/60'
  : 'border-t-2 border-guainia-slow-water/60';
---

<div class={`${theme.cardBg} rounded-lg overflow-hidden ${borderClass} p-5 flex flex-col gap-4 h-full`}>
  <div>
    <h4 class={`text-xl font-bold ${theme.titleColor} mb-2`}>{etapa}</h4>
    <p class="text-gray-200 text-sm leading-relaxed">{descripcion}</p>
  </div>

  {imagenes && imagenes.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
      {imagenes.map((img, idx) => (
        <div class="flex flex-col items-center bg-stone-900/50 rounded-lg p-2">
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-auto max-h-64 object-contain rounded"
            loading="lazy"
          />
          <span class="text-xs text-gray-400 mt-2 flex items-center gap-1">
            {img.tipo === 'real' ? '📸 Fotografía real' : '🎨 Render técnico'}
          </span>
        </div>
      ))}
    </div>
  )}
</div>