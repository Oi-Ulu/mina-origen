---
export interface Props {
  titulo: string;
  subtitulo: string;
  imagenUrl: string;
  descripcion?: string;
}
const { titulo, subtitulo, imagenUrl, descripcion } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const imgSrc = imagenUrl.startsWith('/') ? imagenUrl : `${baseUrl}${imagenUrl}`;
---

<div class="relative rounded-xl overflow-hidden mb-8">
  <img src={imgSrc} alt={titulo} class="w-full h-64 md:h-96 object-cover" />
  <div class="absolute inset-0 bg-guainia-bedrock/60 hover:bg-guainia-deep-water/50 transition-all duration-500 flex flex-col justify-center items-center text-center p-6">
    <h1 class="text-4xl md:text-6xl font-serif text-white mb-2">{titulo}</h1>
    <p class="text-guainia-mist text-lg md:text-xl mb-3">{subtitulo}</p>
    <div class="w-12 h-0.5 bg-guainia-deep-water mb-4"></div>
    {descripcion && <p class="text-gray-300 max-w-md">{descripcion}</p>}
  </div>
</div>