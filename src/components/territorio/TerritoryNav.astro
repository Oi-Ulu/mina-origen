---
export interface Props {
  territorioId: 'guainia' | 'marmato';
  active: 'territorio' | 'proceso' | 'materiales';
  activeClass: string;
}
const { territorioId, active, activeClass } = Astro.props;

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';

const territorioUrl = `${baseUrl}territorio/${territorioId}/`;
const procesoUrl = `${baseUrl}territorio/${territorioId}/proceso`;
const materialesUrl = `${baseUrl}territorio/${territorioId}/materiales`;
---

<nav class="flex gap-6 border-b border-stone-700 pb-2 mb-8">
  <a
    href={territorioUrl}
    class={`pb-2 ${active === 'territorio' ? activeClass : 'text-gray-400 hover:text-gray-200 border-transparent'} border-b-2 transition-colors`}
  >
    Territorio
  </a>
  <a
    href={procesoUrl}
    class={`pb-2 ${active === 'proceso' ? activeClass : 'text-gray-400 hover:text-gray-200 border-transparent'} border-b-2 transition-colors`}
  >
    Proceso
  </a>
  <a
    href={materialesUrl}
    class={`pb-2 ${active === 'materiales' ? activeClass : 'text-gray-400 hover:text-gray-200 border-transparent'} border-b-2 transition-colors`}
  >
    Materiales
  </a>
</nav>