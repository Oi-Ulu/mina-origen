---
export interface Documento {
  nombre: string;
  año: string;
  tipo: string;
  url: string;
}
export interface Props {
  documentos: Documento[];
}
const { documentos } = Astro.props;
---

<div class="bg-stone-900/50 rounded-lg p-4 border border-stone-800">
  <h3 class="text-lg font-semibold text-white mb-3 flex items-center gap-2">
    📄 Archivos técnicos
  </h3>
  {documentos.length === 0 ? (
    <p class="text-gray-500 text-sm">No hay documentos disponibles.</p>
  ) : (
    <ul class="space-y-2">
      {documentos.map(doc => (
        <li class="flex justify-between items-center border-b border-stone-800 pb-2">
          <a href={doc.url} class="text-guainia-mist hover:text-guainia-foam transition-colors text-sm">
            {doc.nombre}
          </a>
          <span class="text-xs text-gray-500">{doc.año} • {doc.tipo}</span>
        </li>
      ))}
    </ul>
  )}
</div>