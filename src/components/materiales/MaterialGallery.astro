---
import MaterialCard from './MaterialCard.astro';

export interface Material {
  nombre: string;
  tipo: string;
  imagenUrl: string;
  origen: string;
}
export interface Props {
  materiales: Material[];
  tema: 'marmato' | 'guainia';
  territorioId: 'guainia' | 'marmato';
}
const { materiales, tema, territorioId } = Astro.props;
---

<div class="material-gallery-container">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {materiales.map(material => (
      <MaterialCard material={material} tema={tema} territorioId={territorioId} />
    ))}
  </div>

  <!-- Modal (lightbox) -->
  <div id="materialModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm transition-all duration-300" onclick="closeMaterialModal()">
    <div class="relative max-w-6xl w-full mx-4 bg-stone-900 rounded-xl overflow-hidden border border-stone-700 shadow-2xl" onclick="event.stopPropagation()">
      <button class="absolute top-4 right-4 text-gray-300 hover:text-white text-3xl p-2 z-10" onclick="closeMaterialModal()">&times;</button>
      <div class="flex flex-col md:flex-row">
        <div class="md:w-2/3 bg-stone-950 flex items-center justify-center p-8">
          <img id="modalImage" src="" alt="" class="max-w-full max-h-[70vh] object-contain" />
        </div>
        <div class="md:w-1/3 p-6 flex flex-col gap-3">
          <h2 id="modalTitle" class="text-3xl font-serif text-marmato-clay"></h2>
          <p id="modalType" class="text-gray-300 text-lg"></p>
          <p id="modalOrigin" class="text-sm text-gray-400"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.openMaterialModal = (cardElement) => {
    const modal = document.getElementById('materialModal');
    const data = JSON.parse(cardElement.dataset.material);
    document.getElementById('modalImage').src = data.imagenUrl;
    document.getElementById('modalTitle').innerText = data.nombre;
    document.getElementById('modalType').innerText = data.tipo;
    document.getElementById('modalOrigin').innerText = `Origen: ${data.origen}`;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeMaterialModal = () => {
    const modal = document.getElementById('materialModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  // Cerrar con tecla ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMaterialModal();
    }
  });
</script>

<style>
  #materialModal {
    transition: opacity 0.2s ease;
  }
  #materialModal.flex {
    opacity: 1;
  }
  #materialModal.hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>