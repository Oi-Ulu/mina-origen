---
import { contextTheme } from '../../lib/themes.js';

export interface Props {
  material: {
    nombre: string;
    tipo: string;
    imagenUrl: string;
    origen: string;
  };
  territorioId: 'guainia' | 'marmato';
  tema: 'marmato' | 'guainia';
}
const { material, territorioId, tema } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const theme = contextTheme[tema];
const imgSrc = material.imagenUrl.startsWith('/') ? material.imagenUrl : `${baseUrl}${material.imagenUrl}`;
const procesoLink = `${baseUrl}territorio/${territorioId}/proceso`;
const territorioLink = `${baseUrl}territorio/${territorioId}/`;
const negocioLink = `${baseUrl}contacto`;
const materialData = JSON.stringify({
  nombre: material.nombre,
  tipo: material.tipo,
  origen: material.origen,
  imagenUrl: imgSrc,
});
---

<div
  class="group bg-stone-900 rounded-lg overflow-hidden border border-stone-800 hover:border-stone-600 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col h-full cursor-pointer"
  data-material={materialData}
  onclick="window.openMaterialModal(this)"
>
  <div class="relative w-full bg-stone-950 flex items-center justify-center p-4" style="aspect-ratio: 16 / 9;">
    <img
      src={imgSrc}
      alt={material.nombre}
      class="w-full h-full object-contain"
      loading="lazy"
    />
  </div>
  <div class="p-5 flex flex-col flex-grow">
    <h3 class={`text-xl font-bold ${theme.textTitle} mb-1`}>{material.nombre}</h3>
    <p class="text-sm text-gray-400 mb-2">{material.tipo}</p>
    <p class="text-xs text-gray-500 mb-4">Origen: {material.origen}</p>
    <div class="flex flex-wrap gap-3 mt-auto">
      <a href={procesoLink} class="text-sm bg-stone-800 hover:bg-stone-700 text-gray-300 px-4 py-1.5 rounded transition-colors" onclick="event.stopPropagation()">
        Ver proceso
      </a>
      <a href={territorioLink} class="text-sm border border-stone-700 hover:bg-stone-800 text-gray-300 px-4 py-1.5 rounded transition-colors" onclick="event.stopPropagation()">
        Ver territorio
      </a>
      <a href={negocioLink} class="text-sm border border-marmato-clay/40 hover:bg-marmato-clay/20 text-gray-300 px-4 py-1.5 rounded transition-colors" onclick="event.stopPropagation()">
        📈 Modelo de negocio
      </a>
    </div>
  </div>
</div>