---
const base = Astro.base;
---

<div class="grid grid-cols-1 md:grid-cols-2 h-[70vh] min-h-[500px]">
  <a href={`${base}/origen-guainia`} class="relative overflow-hidden group">
    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
         style={`background-image: url('${base}/images/placeholder.svg');`}>
      <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition"></div>
    </div>
    <div class="relative h-full flex flex-col justify-end p-8 md:p-12">
      <h2 class="font-serif text-4xl md:text-5xl text-white mb-2">Guainía</h2>
      <p class="text-xl text-gray-200 mb-4">Oro Aluvial Amazónico</p>
      <span class="inline-block w-12 h-0.5 bg-guinia-gold-matte mb-4"></span>
      <p class="text-sm text-gray-300 max-w-md">Extracción gravimétrica sin mercurio. Restauración vegetal en ciclo cerrado.</p>
    </div>
  </a>
  <a href={`${base}/origen-marmato`} class="relative overflow-hidden group">
    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
         style={`background-image: url('${base}/images/placeholder.svg');`}>
      <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition"></div>
    </div>
    <div class="relative h-full flex flex-col justify-end p-8 md:p-12">
      <h2 class="font-serif text-4xl md:text-5xl text-white mb-2">Marmato</h2>
      <p class="text-xl text-gray-200 mb-4">Plata y Oro de Veta Andina</p>
      <span class="inline-block w-12 h-0.5 bg-marmato-silver-vein mb-4"></span>
      <p class="text-sm text-gray-300 max-w-md">Minería subterránea selectiva. Reforestación altoandina.</p>
    </div>
  </a>
</div>