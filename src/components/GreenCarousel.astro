---
export interface Props {
  origen: 'guainia' | 'marmato';
}

const { origen } = Astro.props;

const images = origen === 'guainia' 
  ? [
      { src: '/images/placeholder.svg', title: 'Extracción Selectiva', desc: 'Método manual con batea. Cero mercurio.' },
      { src: '/images/placeholder.svg', title: 'Restauración en Curso', desc: 'Siembra de vetiver y especies nativas.' },
    ]
  : [
      { src: '/images/placeholder.svg', title: 'Socavón Artesanal', desc: 'Ventilación natural, arranque selectivo.' },
      { src: '/images/placeholder.svg', title: 'Planta Gravimétrica', desc: 'Concentración sin cianuro.' },
    ];
---

<div class="snap-x snap-mandatory flex overflow-x-auto pb-8 gap-4 px-4">
  {images.map((img) => (
    <div class="snap-center shrink-0 w-4/5 md:w-1/2 lg:w-1/3 bg-stone-900 rounded-lg overflow-hidden">
      <img src={img.src} alt={img.title} class="w-full h-64 object-cover" loading="lazy" />
      <div class="p-4">
        <h4 class="font-bold text-lg">{img.title}</h4>
        <p class="text-sm text-gray-400">{img.desc}</p>
      </div>
    </div>
  ))}
</div>