---
import LayoutBase from '../layouts/LayoutBase.astro';
import HeroSplit from '../components/HeroSplit.astro';
import TrustBadges from '../components/TrustBadges.astro';
---

<LayoutBase title="Inicio" description="Minería de origen sostenible en Guainía y Marmato, Colombia.">
  <HeroSplit />
  <TrustBadges />
  
  <section class="max-w-7xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="font-serif text-3xl md:text-4xl mb-4">Del origen a la confianza</h2>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        Operamos directamente en los distritos mineros de Guainía y Marmato, aplicando prácticas sostenibles que respetan el entorno y las comunidades.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-stone-900 p-6 rounded-lg border-l-4 border-guinia-gold-matte">
        <h3 class="font-serif text-2xl mb-3 text-guinia-gold-matte">Guainía – Oro Aluvial</h3>
        <p class="text-gray-300">Métodos gravimétricos manuales, agua reciclada y restauración con especies nativas en menos de 6 meses.</p>
        <a href="/origen-guainia" class="inline-block mt-4 text-guinia-gold-matte hover:underline">Conozca el proceso →</a>
      </div>
      <div class="bg-stone-900 p-6 rounded-lg border-l-4 border-marmato-silver-vein">
        <h3 class="font-serif text-2xl mb-3 text-marmato-silver-vein">Marmato – Plata y Oro de Veta</h3>
        <p class="text-gray-300">Minería subterránea artesanal, concentración gravimétrica sin cianuro y reforestación altoandina.</p>
        <a href="/origen-marmato" class="inline-block mt-4 text-marmato-silver-vein hover:underline">Conozca el proceso →</a>
      </div>
    </div>
  </section>
</LayoutBase>