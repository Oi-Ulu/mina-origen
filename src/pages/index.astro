---
import LayoutBase from '../layouts/LayoutBase.astro';
import TrustBadges from '../components/shared/TrustBadges.astro';
import TerritorySelector from '../components/shared/TerritorySelector.astro';
---

<LayoutBase title="Inicio" description="Minería de origen sostenible en Guainía y Marmato, Colombia">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center text-white mb-12">Nuestros territorios</h2>
    <TerritorySelector 
      territorios={[
        {id: "guainia", nombre: "Guainía", material: "Oro Aluvial", imagenUrl: `${import.meta.env.BASE_URL}images/guainia/card-selector.jpg`},
        {id: "marmato", nombre: "Marmato", material: "Plata y Oro de Veta", imagenUrl: `${import.meta.env.BASE_URL}images/marmato/card-selector.jpg`}
      ]}
    />
  </section>
  
  <TrustBadges />
</LayoutBase>