---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Contacto" description="Comuníquese con nosotros para conocer más sobre nuestro oro y plata de origen.">
  <div class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h1 class="font-serif text-4xl mb-6">Contacto</h1>
    <p class="text-xl text-gray-400 mb-12">Estamos ubicados en los distritos mineros de Guainía y Caldas, Colombia.</p>
    
    <div class="bg-stone-900 p-8 rounded-lg inline-block text-left">
      <p class="mb-4"><span class="font-bold">📞 Teléfono:</span> +57 300 123 4567</p>
      <p class="mb-4"><span class="font-bold">✉️ Correo:</span> contacto@minaorigen.com</p>
      <p class="mb-6"><span class="font-bold">📍 Oficina principal:</span> Calle 123 #45-67, Bogotá (citas previas)</p>
      <a href="https://wa.me/573001234567" class="inline-block bg-guinia-gold-matte text-black font-bold py-3 px-6 rounded hover:bg-opacity-80 transition">
        Enviar mensaje por WhatsApp
      </a>
    </div>
  </div>
</LayoutBase>